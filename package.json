{
  "name": "bullrun-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server exposing Bullrun market-data + portfolio tools over Streamable HTTP; an OAuth 2.1 protected resource (RFC 9728) with per-user token forwarding and an authless toggle.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test-auth.mjs && node scripts/test-e2e.mjs && node scripts/test-authless.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:authless": "node scripts/test-authless.mjs",
    "inspector": "npx -y @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
